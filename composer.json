{
    "name": "tobento/app-html-sanitizer",
    "version": "2.0.1",
    "type": "library",
    "description": "App html sanitizer to sanitize untrusted HTML code.",
    "keywords": [
        "tobento",
        "package",
        "app",
        "html sanitizer"
	],
    "homepage": "https://www.tobento.ch",
    "license": "MIT",
    "authors": [
        {
            "name": "Tobias Strub",
            "email": "info@tobento.ch",
            "homepage": "https://www.tobento.ch"
        }
    ],
    "minimum-stability": "dev",
    "prefer-stable": true,
    "require": {
        "php": ">=8.4",
        "tobento/app": "^2.0",
        "tobento/app-migration": "^2.0",
        "tobento/service-filesystem": "^2.0",
        "symfony/html-sanitizer": "^7.3"
    },  
    "require-dev": {
        "phpunit/phpunit": "^12.3",
        "vimeo/psalm": "^6.13",
        "tobento/app-view": "^2.0",
        "ezyang/htmlpurifier": "^4.18"
    },
    "autoload": {
        "psr-4": {
            "Tobento\\App\\HtmlSanitizer\\": "src"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Tobento\\App\\HtmlSanitizer\\Test\\": "tests"
        }
    },
    "scripts": {
        "test": "phpunit --testdox --colors=always",
        "psalm": "vendor/bin/psalm"
    }
}